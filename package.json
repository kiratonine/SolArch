{
  "name": "solarch",
  "private": true,
  "version": "0.0.0",
  "description": "SolArch monorepo — protected .slr archives, marketplace and viewer",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "npm run start:dev --workspace apps/api",
    "api:build": "npm run build --workspace apps/api",
    "api:test": "npm run test --workspace apps/api",
    "api:lint": "npm run lint --workspace apps/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "web": "npm run dev --workspace apps/web",
    "web:build": "npm run build --workspace apps/web",
    "web:test": "npm run test --workspace apps/web",
    "web:lint": "npm run lint --workspace apps/web"
  }
}
