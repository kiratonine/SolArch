{
  "name": "solarch-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "lint": "pnpm --filter @solarch/viewer lint",
    "test": "pnpm --filter @solarch/viewer test",
    "build": "pnpm --filter @solarch/viewer build",
    "viewer:devnet:preflight": "node scripts/viewer-live-devnet-e2e.mjs preflight",
    "viewer:devnet:build": "node scripts/viewer-live-devnet-e2e.mjs build",
    "viewer:devnet:evidence": "node scripts/viewer-live-devnet-e2e.mjs evidence",
    "viewer:devnet:checklist": "node scripts/viewer-live-devnet-e2e.mjs checklist",
    "viewer:devnet:evidence-template": "node scripts/viewer-live-devnet-e2e.mjs template",
    "test:live-e2e-harness": "node --test scripts/viewer-live-devnet-e2e.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "@angular-devkit/core>picomatch": "4.0.4",
      "@nestjs/cli>glob": "10.5.0",
      "@nestjs/config>lodash": "4.18.1",
      "@nestjs/platform-express>multer": "2.3.0",
      "@nestjs/swagger>js-yaml": "4.3.2",
      "@nestjs/swagger>lodash": "4.18.1",
      "external-editor>tmp": "0.2.7"
    }
  },
  "dependencies": {
    "bs58": "^6.0.0"
  }
}
