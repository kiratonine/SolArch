{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SolArch Viewer",
  "version": "0.1.0",
  "identifier": "app.solarch.viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "SolArch Viewer",
        "width": 1080,
        "height": 720,
        "minWidth": 375,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SolArch",
    "category": "Utility",
    "shortDescription": "Secure viewer for SolArch archives",
    "fileAssociations": [
      {
        "ext": ["slr"],
        "name": "SolArch Archive",
        "description": "SolArch Archive",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
