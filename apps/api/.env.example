# ==============================================================================
# SolArch API Environment Configuration
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://solarch:solarch_dev@localhost:5432/solarch?schema=public"

# Auth / keyed credential verification (inject through deployment secret storage)
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
INTENT_HMAC_SECRET=""
DEVICE_REFRESH_HMAC_SECRET=""
ACK_KEK_SECRET=""

# Storage
STORAGE_LOCAL_ROOT="./storage_data"

# Solana Network Configuration
# Devnet / Testnet / Localnet / Mainnet-beta
SOLANA_NETWORK="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_LIVE_DEVNET="false"

# Canonical USDC Mint
# Devnet USDC: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_USDC_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"

# Public HTTPS root used in Solana Pay URLs; no path/query/fragment/credentials.
PUBLIC_API_ORIGIN=""

# Exact native solarch CLI executable used by the duplex ArchiveBuilder adapter.
SOLARCH_CLI_PATH=""

# SolArch Fee Payer & Platform Wallet. Never commit the fee-payer secret.
SOLARCH_FEE_PAYER_SECRET=""
SOLARCH_PLATFORM_WALLET=""

# Ed25519 Server Signing Keys (Base64 64-byte Ed25519 Secret Key)
LICENSE_SIGNING_PRIVATE_KEY_B64=""
LICENSE_SIGNING_PUBLIC_KEY_B64=""
LICENSE_KEY_ID=""

ARCHIVE_SIGNING_PRIVATE_KEY_B64=""
ARCHIVE_SIGNING_PUBLIC_KEY_B64=""
ARCHIVE_KEY_ID=""
