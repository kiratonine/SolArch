# SolArch API: local development only; copy to .env, never overwrite an existing .env.
# This profile uses existing non-live development fallbacks, NOT payment authority.
# Never expose it publicly or use it for real purchases or sensitive content.
# NODE_ENV=development + SOLANA_NETWORK=devnet STILL enables live validation;
# SOLANA_LIVE_DEVNET=false does not disable that validation. For real Devnet:
# set devnet + its RPC below, HTTPS origin, absolute persistent storage, actual
# wallets/role-separated keys and independent secrets. See docs/INTEGRATION.md.
# Keep secrets in private local files or deployment secret storage, never Git/logs.

# API listen port; optional (default 3000). Choose a free local TCP port.
PORT=3000
# Runtime mode; optional. Use development locally, production only when provisioned.
NODE_ENV=development
# Browser CORS allowlist; optional locally (localhost:5173 is allowed automatically).
# For deployment, supply comma-separated canonical HTTPS frontend origins, no paths.
WEB_ALLOWED_ORIGINS=""

# Prisma connection; required. This uses Docker Compose's PUBLIC throwaway defaults,
# not deployment credentials. Override privately for your own LOCAL database.
# Never run migrations against an existing/shared/production database from this guide.
DATABASE_URL="postgresql://solarch:solarch_dev@localhost:5432/solarch?schema=public"

# JWT signing secret; required live, optional non-live. Generate >=32 UTF-8 bytes
# with Node crypto.randomBytes(32).toString('hex') into a private env file.
JWT_SECRET=""
# JWT lifetime; optional (default 7d). Supply a duration accepted by @nestjs/jwt.
JWT_EXPIRES_IN="7d"
# Intent credential HMAC; required live, optional non-live. Generate an independent
# >=32-byte UTF-8 secret with crypto.randomBytes(32).toString('hex'); store privately.
INTENT_HMAC_SECRET=""
# Refresh credential HMAC; required live, optional non-live. Generate a DIFFERENT
# >=32-byte UTF-8 random secret, as above; never reuse the intent or custody secret.
DEVICE_REFRESH_HMAC_SECRET=""
# ACK custody encryption input; required live, optional non-live. Generate another
# independent >=32-byte UTF-8 random secret; retain securely to decrypt existing custody.
ACK_KEK_SECRET=""

# Persistent root for uploads, .slr, encrypted custody, covers and staging.
# Optional locally; required live as an absolute writable NON-TEMPORARY OS path.
# Choose/provision your own directory (e.g. /var/lib/solarch/storage on Linux).
STORAGE_LOCAL_ROOT="./storage_data"

# Network label; optional, but its default devnet enables live validation.
# Explicit localnet permits LOCAL UI/API development only; it starts no validator.
# Real test-USDC integration: change to devnet and provision all live requirements.
SOLANA_NETWORK="localnet"
# RPC endpoint; optional non-live, required live. Start your own local validator
# for this URL; without one health/ready reports degraded Solana RPC.
# Official public Devnet RPC: https://api.devnet.solana.com (rate-limited).
# https://solana.com/docs/references/clusters
SOLANA_RPC_URL="http://127.0.0.1:8899"
# Explicit live-Devnet validation; optional, default false. Use true only when ready;
# false is NOT a bypass for devnet/mainnet-beta or NODE_ENV=production.
SOLANA_LIVE_DEVNET="false"
# USDC mint; required live, optional non-live. Official Circle Solana Devnet mint:
# https://developers.circle.com/stablecoins/usdc-contract-addresses
# This address is NOT deployed automatically on your local validator.
SOLANA_USDC_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"
# ATA pre-publication check bypass; optional, default false. Keep false for real
# integration; true is only for isolated non-payment tests with controlled fixtures.
SOLANA_SKIP_ATA_CHECK="false"

# Public API root for Solana Pay/cover URLs; optional locally, REQUIRED live.
# Obtain your deployed/tunneled HTTPS origin, with no credentials/path/query/fragment.
# Replace this local URL for real Devnet; http://localhost is not live-compatible.
PUBLIC_API_ORIGIN="http://localhost:3000"
# Native solarch executable; required live and for archive uploads unless on PATH.
# Build cargo build --locked --release -p solarch-cli. Set the absolute path to
# target/release/solarch on Linux/WSL or target\release\solarch.exe on Windows.
SOLARCH_CLI_PATH=""

# Fee-payer private key; required live, optional non-live. Generate a separate Solana
# Devnet keypair privately; fund with test SOL. Accepted: JSON array of 64 byte
# integers or canonical Base58 encoding of the 64-byte secret; NEVER a seed phrase.
SOLARCH_FEE_PAYER_SECRET=""
# Platform recipient; required live, optional non-live. Obtain the canonical Base58
# PUBLIC address of your platform Solana wallet; do not put its private key here.
SOLARCH_PLATFORM_WALLET=""

# License signing private key; required live, optional non-live. Generate a fresh
# Ed25519 pair with tweetnacl.sign.keyPair() in a private provisioning script.
# Save canonical padded Base64: 32-byte seed or 64-byte secret, never log either.
LICENSE_SIGNING_PRIVATE_KEY_B64=""
# Matching license PUBLIC key; required live. Derive 32 bytes from the same pair
# and encode as canonical padded Base64; distribute only this key to Viewer builds.
LICENSE_SIGNING_PUBLIC_KEY_B64=""
# License key identifier; required live, optional non-live. Choose [a-z0-9_-]{1,32}
# and use the same identifier in the matching Viewer license trust anchor.
LICENSE_KEY_ID=""

# Archive signing private key; required live, optional non-live. Generate a SECOND,
# independent Ed25519 pair as above; canonical padded Base64 of 32 or 64 private bytes.
ARCHIVE_SIGNING_PRIVATE_KEY_B64=""
# Matching archive PUBLIC key; required live. Derive/encode the independent pair's
# 32-byte public key; it must differ from the license public key and match Viewer trust.
ARCHIVE_SIGNING_PUBLIC_KEY_B64=""
# Archive key identifier; required live, optional non-live. Choose [a-z0-9_-]{1,32}
# and use the same identifier in the matching Viewer archive trust anchor.
ARCHIVE_KEY_ID=""

# Test-only clock overrides: optional and MUST remain UNSET for normal dev/release.
# Do not add empty assignments: even their presence invokes strict clock validation.
# SOLARCH_LIVE_E2E_CLOCK_ENABLED: set true only in approved NODE_ENV=test,
# SOLANA_LIVE_DEVNET=true + devnet runs; otherwise startup rejects the override.
# SOLARCH_LIVE_E2E_CLOCK_UNIX_SECONDS: coordinated bounded Unix seconds supplied
# by the isolated E2E harness, not a shorter license window or clock-skew bypass.
# OS-provided PATH, SYSTEMROOT, TEMP, TMP, USERPROFILE, HOMEDRIVE and HOMEPATH are
# passed to the CLI's sanitized subprocess environment; do not override them here.
