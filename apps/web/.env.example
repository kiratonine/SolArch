# All VITE_* values are PUBLIC and embedded in the browser build. Never put secrets here.

# Backend root URL; optional (default localhost:3000). Do not append /v1:
# the API client adds that prefix. Use your HTTPS Backend origin for deployment.
VITE_API_BASE_URL=http://localhost:3000

# Real local API by default. Optional: true enables MSW + a demo wallet ONLY in dev.
# Mock mode is a UI preview, not payment/E2E evidence; production never enables MSW.
# With false, creator login requires a real compatible Solana wallet extension.
VITE_ENABLE_MSW=false

# Optional direct HTTPS Windows x64 installer URL. Empty disables installer download.
# This public prerelease is unsigned, Devnet/test-USDC only and configured for the
# deployed Backend, NOT your local API. Local archives need matching Viewer trust keys.
VITE_VIEWER_DOWNLOAD_URL=https://github.com/kiratonine/SolArch/releases/download/v0.1.0/SolArch.Viewer_0.1.0_x64-setup.exe
